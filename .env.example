# ==========================================
# KALAINOVA Environment Configuration
# ==========================================

# Application
APP_NAME=KALAINOVA
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string
ENCRYPTION_KEY=change-me-to-a-url-safe-base64-fernet-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL / Supabase)
# For local development without Postgres, leave DATABASE_URL as sqlite or set your Postgres/Supabase URL:
# postgresql+psycopg2://postgres:postgres@localhost:5432/kalainova
DATABASE_URL=sqlite:///./kalainova_dev.db

# Supabase (Optional for Auth & Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kalainova-media

# External AI / LLM Providers (Optional - never hardcode keys)
# Supported LLM_PROVIDER: openai | gemini | huggingface | none
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
HF_TOKEN=
HF_HOME=E:/hf_cache

# Model Controls
ENABLE_LOCAL_BIREFNET=true
ENABLE_LOCAL_SPEECH=false
ENABLE_LOCAL_TRANSLATION=false
ENABLE_LOCAL_EMBEDDINGS=true

# CORS
CORS_ORIGINS=["http://localhost:8081","http://localhost:5173","http://localhost:3000","*"]

# Mobile / Admin Frontend
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
VITE_API_URL=http://localhost:8000/api/v1
